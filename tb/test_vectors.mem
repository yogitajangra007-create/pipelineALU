// Test Vectors for Pipelined ALU
// Format: operand_a  operand_b  opcode  expected_result
// All values in hexadecimal
// Opcode: 0=ADD, 1=SUB, 2=AND, 3=OR, 4=XOR
//
// A    B    OP  Expected
19   0A   0   023   // 25 + 10 = 35
32   0F   1   023   // 50 - 15 = 35
AA   55   2   000   // 0xAA & 0x55 = 0x00
AA   55   3   0FF   // 0xAA | 0x55 = 0xFF
FF   0F   4   0F0   // 0xFF ^ 0x0F = 0xF0
C8   64   0   12C   // 200 + 100 = 300
1E   1E   1   000   // 30 - 30 = 0
AB   AB   4   000   // 0xAB ^ 0xAB = 0x00
